# Base URL backend, termasuk prefix /api/v1. Server-only: hanya dibaca oleh
# BFF (src/app/api) dan Server Action, tidak pernah ter-bundle ke browser.
# BE default memakai PORT=3000 yang bentrok dengan `next dev`; jalankan BE
# lokal di port lain (mis. PORT=4000 di .env BE).
ASE_BACKEND_URL=http://localhost:4000/api/v1
